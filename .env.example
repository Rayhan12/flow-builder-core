# Copy this file to .env.local and fill in the values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# These web config values are not secrets, but keep .env.local out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Firebase Emulator Suite (auth 9099, firestore 8080).
# With emulators you can leave the values above as the demo defaults.
VITE_USE_EMULATORS=true

# Never put LLM API keys (Gemini, OpenRouter, ...) in this file.
# Each user enters their own key inside the app.
