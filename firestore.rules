rules_version = '2';

// Each user can only read and write their own data.
// Layout:
//   users/{uid}                                  profile and settings
//   users/{uid}/diagrams/{diagramId}             one diagram (versioned JSON)
//   users/{uid}/diagrams/{diagramId}/messages/{messageId}   AI chat history
//   users/{uid}/diagrams/{diagramId}/versions/{versionId}   saved snapshots
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validDiagramWrite(uid) {
      return isOwner(uid)
        && request.resource.data.ownerId == uid
        && request.resource.data.schemaVersion is int
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /diagrams/{diagramId} {
        allow read: if isOwner(uid);
        allow create, update: if validDiagramWrite(uid);
        allow delete: if isOwner(uid);

        // Named subcollections only. Do not use {name=**} here: a recursive
        // wildcard also matches zero segments and would bypass diagram checks.
        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }

        match /versions/{versionId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
