rules_version = '2';

// Each user can only read and write their own data.
// Layout:
//   users/{uid}                                  profile and settings
//   users/{uid}/projects/{projectId}             project metadata
//   users/{uid}/projects/{projectId}/diagrams/{diagramId}
//   users/{uid}/projects/{projectId}/diagrams/{diagramId}/messages/{messageId}
//   users/{uid}/projects/{projectId}/diagrams/{diagramId}/versions/{versionId}
//   users/{uid}/agentChats/{chatId}                AI agent panel (per user)
//   users/{uid}/agentChats/{chatId}/messages/{messageId}
//   users/{uid}/diagrams/{diagramId}             legacy path (migration)
//   mcpTokens/{sha256hex}                        MCP personal access tokens (hash only)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function mcpTokenOwner() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function validMcpTokenCreate() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.revoked == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }

    function validMcpTokenUpdate() {
      return mcpTokenOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['revoked', 'name', 'lastUsedAt']);
    }

    function validDiagramWrite(uid) {
      return isOwner(uid)
        && request.resource.data.ownerId == uid
        && request.resource.data.schemaVersion is int
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /projects/{projectId} {
        allow read, create, update, delete: if isOwner(uid);

        match /diagrams/{diagramId} {
          allow read: if isOwner(uid);
          allow create, update: if validDiagramWrite(uid);
          allow delete: if isOwner(uid);

          match /messages/{messageId} {
            allow read, write: if isOwner(uid);
          }

          match /versions/{versionId} {
            allow read, write: if isOwner(uid);
          }
        }
      }

      match /agentChats/{chatId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }

      // Legacy top-level diagrams (readable and deletable for migration).
      match /diagrams/{diagramId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if validDiagramWrite(uid);

        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }

        match /versions/{versionId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // MCP tokens: only the owner can create, read, update or delete their docs.
    // Docs are keyed by sha256(token); the raw token is never stored.
    match /mcpTokens/{tokenHash} {
      allow create: if validMcpTokenCreate();
      allow get, list: if mcpTokenOwner();
      allow update: if validMcpTokenUpdate();
      allow delete: if mcpTokenOwner();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}