{
  "name": "flow-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulators": "firebase emulators:exec --only auth,firestore --project flow-builder-core \"npx vitest run\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project flow-builder-core \"npx playwright test\"",
    "emulators": "firebase emulators:start --only auth,firestore --project flow-builder-core",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "brand:icons": "node scripts/brand-icons.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^13.0.3",
    "elkjs": "^0.12.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "sharp": "^0.34.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  }
}
